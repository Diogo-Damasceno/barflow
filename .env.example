# BarFlow — variáveis de ambiente
# Copie para .env e ajuste. NUNCA comite o .env real.

# Banco (usado pelo Prisma e pela app)
DATABASE_URL="postgresql://barflow:barflow@localhost:5432/barflow?schema=public"

# JWT
JWT_SECRET="change-me-access-secret-min-32-chars!!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars!!"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# App
PORT=3001
NODE_ENV="development"
# Origem do frontend (CORS). Separe por vírgula se houver várias.
CORS_ORIGIN="http://localhost:3000"
# Define para "true" atrás de proxy HTTPS (ativa HSTS no Helmet)
HTTPS="false"

# Seed (uso interno de demo)
SEED_OWNER_EMAIL="dono@barflow.dev"
SEED_OWNER_PASSWORD="SenhaForte@123"
